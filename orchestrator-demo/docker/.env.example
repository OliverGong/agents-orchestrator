# Orchestrator stack — environment overrides.
# Copy to `.env` (same directory as docker-compose.yml) and edit freely;
# every value below is optional, the defaults match the local development
# setup. The same file is the single place to point the bundle at another
# environment (remote model backend, external database, different ports).

# --- app ---
# Version stamp for the built image (must match the pom version you deploy).
APP_VERSION=2.1.0
# Host port for the console / REST API.
APP_PORT=8080

# --- model backend ---
# The orchestrator talks to an OpenAI-compatible/Ollama backend. Point it at
# any reachable host instead of the Docker host when deploying elsewhere.
SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- tracing / metrics ---
# OTLP gRPC endpoint; "tempo" resolves inside the compose network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# --- persistence ---
# Control-plane store: db (PostgreSQL, default) or file (bundled JSON).
ORCHESTRATOR_CONTROL_STORE=db
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
# Change for any shared deployment.
POSTGRES_PASSWORD=orchestrator

# --- security ---
# Base64-encoded AES-256 key; set it to encrypt MCP server secrets at rest.
ORCHESTRATOR_CRYPTO_KEY=
